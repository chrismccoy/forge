# Copy to .env in the workspace and fill in. Keep values in single quotes,
# so characters such as # and spaces in a password are kept.
# Then run: chmod 600 .env

WP_URL='https://staging.example.com'
WP_USER='demo-admin'
WP_PASS='...'

# Optional, only when needed:
# WP_LOGIN_PATH='my-login'          custom login URL set by a security plugin
# WP_HTTP_USER='staging'            HTTP basic auth in front of the site
# WP_HTTP_PASS='...'
# WP_IGNORE_HTTPS_ERRORS=1          local site with a self-signed certificate
