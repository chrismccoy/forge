{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        {
          "color": "#1a1a2e",
          "name": "Contrast",
          "slug": "contrast"
        },
        {
          "color": "#e94560",
          "name": "Accent",
          "slug": "accent"
        },
        {
          "color": "#f5f5f5",
          "name": "Base 2",
          "slug": "base-2"
        },
        {
          "color": "#ffffff",
          "name": "Base",
          "slug": "base"
        }
      ],
      "gradients": [],
      "duotone": [],
      "defaultPalette": false,
      "defaultGradients": false
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "Inter, system-ui, -apple-system, sans-serif",
          "name": "Inter",
          "slug": "inter",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "src": [
                "file:./assets/fonts/inter-variable.woff2"
              ]
            }
          ]
        },
        {
          "fontFamily": "Georgia, 'Times New Roman', serif",
          "name": "Serif",
          "slug": "serif"
        }
      ],
      "fontSizes": [
        {
          "fluid": false,
          "name": "Small",
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "fluid": false,
          "name": "Medium",
          "size": "1rem",
          "slug": "medium"
        },
        {
          "fluid": {
            "min": "1.125rem",
            "max": "1.375rem"
          },
          "name": "Large",
          "size": "1.25rem",
          "slug": "large"
        },
        {
          "fluid": {
            "min": "1.5rem",
            "max": "2rem"
          },
          "name": "X-Large",
          "size": "1.75rem",
          "slug": "x-large"
        },
        {
          "fluid": {
            "min": "2rem",
            "max": "3rem"
          },
          "name": "Huge",
          "size": "2.5rem",
          "slug": "huge"
        }
      ],
      "defaultFontSizes": false
    },
    "spacing": {
      "spacingSizes": [
        {
          "name": "1",
          "size": "0.25rem",
          "slug": "10"
        },
        {
          "name": "2",
          "size": "0.5rem",
          "slug": "20"
        },
        {
          "name": "3",
          "size": "1rem",
          "slug": "30"
        },
        {
          "name": "4",
          "size": "1.5rem",
          "slug": "40"
        },
        {
          "name": "5",
          "size": "2rem",
          "slug": "50"
        },
        {
          "name": "6",
          "size": "clamp(2rem, 5vw, 3rem)",
          "slug": "60"
        },
        {
          "name": "7",
          "size": "clamp(2.5rem, 8vw, 4rem)",
          "slug": "70"
        }
      ],
      "defaultSpacingSizes": false,
      "units": [
        "px",
        "rem",
        "%"
      ]
    },
    "blocks": {
      "core/button": {
        "color": {
          "background": true,
          "text": true
        }
      }
    },
    "useRootPaddingAwareAlignments": true,
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "name": "Soft",
          "slug": "soft",
          "shadow": "0 2px 12px rgba(0, 0, 0, 0.08)"
        }
      ]
    },
    "custom": {
      "transition": {
        "base": "150ms ease-in-out"
      },
      "zIndex": {
        "header": "100"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--40)",
      "padding": {
        "left": "var(--wp--preset--spacing--30)",
        "right": "var(--wp--preset--spacing--30)"
      }
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--accent)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--contrast)"
          }
        },
        ":focus-visible": {
          "outline": {
            "color": "var(--wp--preset--color--accent)",
            "style": "solid",
            "width": "2px",
            "offset": "2px"
          }
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--huge)",
          "lineHeight": "1.1",
          "fontWeight": "700"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)",
          "lineHeight": "1.2",
          "fontWeight": "700"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)",
          "lineHeight": "1.3",
          "fontWeight": "600"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)",
          "lineHeight": "1.4",
          "fontWeight": "600"
        }
      },
      "button": {
        "border": {
          "radius": "4px"
        },
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "var(--wp--preset--color--base)"
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--20)",
            "bottom": "var(--wp--preset--spacing--20)",
            "left": "var(--wp--preset--spacing--40)",
            "right": "var(--wp--preset--spacing--40)"
          }
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      },
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--base-2)"
        },
        "border": {
          "color": "var(--wp--preset--color--base-2)",
          "width": "1px"
        }
      }
    }
  },
  "customTemplates": [
    {
      "name": "full-width",
      "title": "Full Width",
      "postTypes": [
        "page"
      ]
    }
  ],
  "templateParts": [
    {
      "area": "header",
      "name": "header",
      "title": "Header"
    },
    {
      "area": "footer",
      "name": "footer",
      "title": "Footer"
    },
    {
      "area": "uncategorized",
      "name": "post-meta",
      "title": "Post Meta"
    }
  ]
}
